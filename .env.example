HOST=127.0.0.1
PORT=4317
DATA_DIR=./data
SOURCE_BASE_URL=https://dash.batrace.top
# Build a public, read-only snapshot locally. No remote push unless configured below.
STATIC_EXPORT_ENABLED=1
STATIC_OUTPUT_DIR=./site
# Dedicated EMPTY GitHub/GitLab repository, not this private application repository.
# Authenticate Git on this computer; never put a token in the URL.
# PUBLISH_GIT_REMOTE=https://github.com/your-name/your-public-court.git
PUBLISH_GIT_BRANCH=main
# Optional public update-request relay. Only the URL is exported to the public site.
# UPDATE_RELAY_URL=https://court-update-relay.your-account.workers.dev
# UPDATE_RELAY_TOKEN=use-the-same-random-secret-as-the-worker-CONSUMER_TOKEN
# No-account alternative: ntfy takes precedence when a topic is set.
# Topic is a public routing identifier, NOT a password. Default cloud cache is 12 hours.
# UPDATE_NTFY_URL=https://ntfy.sh
# UPDATE_NTFY_TOPIC=court-updates-32-random-lowercase-hex-digits
# Public data changes publish immediately after sync or a successful edit (with failure backoff).
# This interval only batches source/interface file changes.
PUBLISH_MIN_INTERVAL_MINUTES=120
# Optional full database backups to Releases in a PRIVATE GitHub repository.
# Authenticate GitHub CLI on this computer first. No tokens in this file.
# CLOUD_BACKUP_REPOSITORY=your-name/your-private-backups
CLOUD_BACKUP_INTERVAL_HOURS=24
CLOUD_BACKUP_RETENTION=14
# CLOUD_BACKUP_PROXY=http://127.0.0.1:7897
# Optional system-independent HTTP proxy for Node.js source requests.
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://127.0.0.1:7897
# Optional, after obtaining a documented match detail endpoint from the provider.
# SOURCE_DETAIL_PATH=/api/matches/{id}
# Set for a reverse proxy using HTTPS. No trailing slash.
# PUBLIC_ORIGIN=https://your-domain.example
# SECURE_COOKIE=1
