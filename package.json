{
  "name": "broken-arrow-court",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private Broken Arrow friends match archive and analytics",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "export:site": "node scripts/export-site.mjs",
    "publish:site": "node scripts/publish-site.mjs",
    "deploy:github": "node scripts/deploy-github-pages.mjs",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check": "node --check src/server.mjs && node --check public/app.js"
  }
}
